{
  "name": "grpc-data-station",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "gRPC data trial-collection station: reflection-driven request forms, unary/server-stream capture, presence-aware export",
  "scripts": {
    "start": "node server/index.js",
    "start:demo": "node demo/server.js",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite --config web/vite.config.ts",
    "dev": "node scripts/dev.js",
    "build": "vite build --config web/vite.config.ts",
    "build:proto": "node scripts/build-descriptors.js",
    "test": "node --test test/*.test.js",
    "test:integration": "node --test test/integration.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "@grpc/grpc-js": "^1.14.7",
    "@grpc/reflection": "^1.0.4",
    "express": "^4.22.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.75.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
